set windows-shell := ["powershell.exe", "-NoLogo", "-NoProfile", "-Command"]
python := "uv run python"
ruff := "uv run ruff"
photoalbums_root := `uv run --directory ".." python -c "from photoalbums.common import get_photo_albums_dir; print(get_photo_albums_dir())"`
bennette_albums_root := `uv run --directory ".." python -c "from photoalbums.lib.album_sets import get_album_set; print(get_album_set('bennette').photos_root)"`

[default]
default:
  @just --list

test:
  {{python}} -m pytest "tests"

quality:
  {{python}} ../scripts/check_skylos.py .
  {{python}} ../scripts/check_vulture.py . --min-confidence 80
  {{ruff}} check --select C90 .

map:
  {{python}} -m photoalbums metadata map "{{photoalbums_root}}" --port 8095

list-render-pipeline-steps:
  {{python}} -m photoalbums process --photos-root "." --list-steps

render-pipeline *args:
  {{python}} -m photoalbums process --photos-root "{{photoalbums_root}}" {{args}}

list-scan-pipeline-steps:
  {{python}} -m photoalbums watch --list-steps

scan-pipeline album="":
  {{python}} -m photoalbums watch {{if album != "" { "--album " + '"' + album + '"' } else { "" }}}

# Scan pipeline using previous LM Studio (http://192.168.4.72:1234/v1)
scan-pipeline-prev album="":
  $env:LMSTUDIO_BASE_URL = "http://192.168.4.72:1234/v1"; {{python}} -m photoalbums watch {{if album != "" { "--album " + '"' + album + '"' } else { "" }}}

bennette-scan-pipeline:
  {{python}} -m photoalbums watch --album bennette --no-stitch-validation --single-scan

bennette-render-pipeline *args:
  {{python}} -m photoalbums process --photos-root "{{bennette_albums_root}}" {{args}}

checksums:
  {{python}} -m photoalbums.sha3_tree_hashes "{{photoalbums_root}}"

verify-checksums:
  {{python}} -m photoalbums.sha3_tree_hashes "{{photoalbums_root}}" --verify
